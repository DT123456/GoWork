# ============================================================
# GoWork 生产环境 Dockerfile
# ============================================================
# 描述: 多阶段构建，优化镜像大小
#
# 构建阶段:
#   阶段1 (builder): 编译 Go 程序
#   阶段2 (运行):   最小化运行镜像
#
# 特点:
#   1. 多阶段构建：最终镜像只包含二进制文件
#   2. 非 root 用户：提升安全性
#   3. 健康检查：监控应用状态
#
# 构建命令:
#   cd GoWork/docker
#   docker build -t gotour:latest .
#
# 运行命令:
#   docker run -p 8080:8080 gotour:latest
# ============================================================

# ============================================================
# 构建参数（可在 docker build 时传入）
# ============================================================

# Go 版本
ARG GO_VERSION=1.22

# 应用名称（二进制文件名）
ARG APP_NAME=app

# 目标平台（用于交叉编译）
ARG TARGETPLATFORM

# 是否启用 CGO（0=静态编译，适合容器）
ARG CGO_ENABLED=0

# ============================================================
# 阶段1: 构建镜像（编译 Go 程序）
# ============================================================
# 
FROM golang:${GO_VERSION} AS builder

# ============================================================
# 环境配置
# ============================================================

# Go 模块代理（解决国内下载问题）
# 优先使用 goproxy.cn，direct 表示直接连接
ENV GOPROXY=https://goproxy.cn,direct

# 关闭 Go 模块校验（国内常用）
ENV GOSUMDB=off

# 启用 Go Modules
ENV GO111MODULE=on

# 设置工作目录
WORKDIR /app

# ============================================================
# 依赖安装
# ============================================================

# 安装 git（go mod download 需要）
RUN apt-get update && apt-get install -y --no-cache git

# ============================================================
# 构建步骤
# ============================================================

# 复制 go.mod 和 go.sum（利用 Docker 缓存）
# 如果这两文件没变，Docker 会使用缓存的层
COPY go.mod go.sum ./

# 下载依赖（生成 go.sum）
RUN go mod download

# 复制源代码
COPY . .

# 编译二进制文件
# -ldflags="-w -s": 移除调试信息和符号表，减小体积
# GOOS=linux: 目标操作系统
# GOARCH=amd64: 目标架构
RUN echo "Building for $TARGETPLATFORM" && \
    CGO_ENABLED=${CGO_ENABLED} \
    GOOS=linux \
    GOARCH=amd64 \
    go build \
    -ldflags="-w -s" \
    -o ${APP_NAME} .

# ============================================================
# 阶段2: 运行镜像（最小化）
# ============================================================
# 从 alpine 基础镜像开始，只包含运行时必需组件
FROM alpine:3.19

# ============================================================
# 系统配置
# ============================================================

# 安装时区数据和证书
# ca-certificates: HTTPS 通信所需
# tzdata: 时区数据
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*
# ============================================================
# 用户配置（安全）
# ============================================================

# 创建非 root 用户和用户组
# 原因：容器内使用 root 有安全风险
# -g 1000: 用户组 ID
# -u 1000: 用户 ID
# -G appgroup: 所属用户组
# -s /bin/sh: 默认 shell
# -D: 不创建 home 目录
RUN addgroup -g 1000 appgroup && \
    adduser -u 1000 -G appgroup -s /bin/sh -D appuser

# 设置工作目录
WORKDIR /app

# ============================================================
# 文件复制
# ============================================================

# 从 builder 阶段复制编译好的二进制文件
# --from=builder: 指定从哪个阶段复制
COPY --from=builder /app/${APP_NAME} .

# ============================================================
# 用户切换
# ============================================================

# 切换到非 root 用户
USER appuser

# ============================================================
# 端口和启动命令
# ============================================================

# 声明容器暴露的端口（文档用途，不实际开放）
EXPOSE 8080

# 健康检查
# 容器运行过程中自动检查应用健康状态
# --interval=30s: 检查间隔
# --timeout=3s:   超时时间
# --start-period=5s: 容器启动后等待时间
# --retries=3:   连续失败次数
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# 启动命令（JSON 数组格式，exec 形式）
CMD ["./${APP_NAME}"]
