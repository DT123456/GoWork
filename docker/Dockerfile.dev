# ============================================================
# GoWork 开发环境 Dockerfile
# ============================================================
# 描述: 开发环境镜像，支持热重载
#
# 特点:
#   1. 基于 Go 官方镜像
#   2. 预装开发工具（air、dlv）
#   3. 支持热重载（代码修改自动重编译）
#
# 使用场景:
#   - 开发调试
#   - 运行测试
#   - 试用第三方库
#
# 构建命令:
#   cd GoWork/docker
#   docker build -f Dockerfile.dev -t gotour:dev .
#
# 运行命令:
#   docker run -it gotour:dev /bin/sh
# ============================================================

# ============================================================
# 基础镜像
# ============================================================

# Go 版本
ARG GO_VERSION=1.22

# 使用官方 Go alpine 镜像（轻量级）
FROM golang:${GO_VERSION}

# ============================================================
# 环境配置
# ============================================================

# Go 模块代理（解决国内访问 golang.org 问题）
# 多个代理用逗号分隔，逗号前的优先，失败时自动切换
ENV GOPROXY=https://goproxy.cn,direct

# 将 Go 工具安装到 /usr/local/bin（PATH 中）
ENV GOBIN=/usr/local/bin

# 关闭 Go 模块校验数据库
# 国内网络访问 sum.golang.org 困难，关闭避免下载失败
ENV GOSUMDB=off

# 强制启用 Go Modules
ENV GO111MODULE=on

# 添加 Go bin 到 PATH
ENV PATH=/go/bin:/usr/local/bin:$PATH

# ============================================================
# 系统工具和 Go 工具安装
# ============================================================

# 安装常用开发工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    # git: 版本控制，go mod download 依赖
    git \
    # curl: 下载工具
    curl \
    # tzdata: 时区数据（时间正确显示）
    tzdata \
    # procps: 进程管理工具
    procps \
    # 删除缓存，减小镜像体积
    && rm -rf /var/lib/apt/lists/*     

# ==========================
# 【关键修复】在 /tmp 安装 air 和 dlv
# 永远不会报 go.mod not found
# ==========================
RUN cd /tmp \
    && go install github.com/air-verse/air@latest \
    && go install github.com/go-delve/delve/cmd/dlv@latest \
    && mv /go/bin/* /usr/local/bin/ || true
    
# ============================================================
# 工作目录
# ============================================================

# 设置工作目录
# 注意：开发环境通常通过 docker-compose 挂载卷覆盖此目录
WORKDIR /app

# ============================================================
# 文件复制
# ============================================================

# 开发环境不复制代码，代码通过 docker-compose volume 挂载
# 仅创建占位文件确保目录存在
RUN test -d /app || mkdir -p /app

# ============================================================
# 端口暴露
# ============================================================

# 声明容器端口（文档用途）
# 8080: Go 应用默认端口
# 2345: Delve 调试器端口
EXPOSE 8080 2345

# ============================================================
# 启动命令
# ============================================================

# 优先使用 air 热重载，fallback 到普通 go run
CMD ["sh", "-c", "command -v air >/dev/null 2>&1 && air || go run ."]
