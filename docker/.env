# ============================================================
# Docker 全局配置文件
# ============================================================

# Go 版本
GO_VERSION=1.22

# 网络配置
NETWORK_NAME=gowork_net

# 镜像仓库（可选）
# DOCKER_REGISTRY=registry.cn-hangzhou.aliyuncs.com
# DOCKER_USERNAME=your_username

# 镜像标签
IMAGE_TAG=latest

# 构建参数
CGO_ENABLED=0
GOOS=linux
GOARCH=amd64
